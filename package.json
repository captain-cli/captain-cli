{
  "name": "@captain/cli",
  "version": "0.2.0",
  "description": "User-facing command line entry point for the Captain ecosystem.",
  "type": "module",
  "bin": {
    "captain": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "test:simple": "npm run build && node --test dist/tests/*.test.js && node dist/cli.js --help && node dist/cli.js bootstrap doctor",
    "test": "npm run test:simple"
  },
  "keywords": [
    "captain",
    "cli",
    "orchestration",
    "build",
    "packaging"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@captain/manifest": "file:../captain",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
